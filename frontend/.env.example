# XRPL endpoint (lending hackathon devnet by default)
XRPL_WSS=wss://lending-hackathon.dev.ripplex.io:51233
NEXT_PUBLIC_XRPL_EXPLORER=https://custom.xrpl.org/lending-hackathon.dev.ripplex.io:51233
# Genesis seed of the standalone devnet, used to fund every demo wallet with XRP
XRPL_GENESIS_SEED=snoPBrXtMeMyMHUVTgbuqAfg1SUTb
# Where registry.json (users, vaults, loans) and platform.json (issuer, AYZE) live — git-ignored
AYZE_DATA_DIR=data
# Signs the session cookie
AYZE_SESSION_SECRET=change-me
